    given-names: Henry
    affiliation: "University of Wisconsin-Madison, Forest and Wildlife Ecology"
    email: hfrye2@wisc.edu
    orcid: "https://orcid.org/0000-0002-2066-5742"
  - family-names: Breuer
    given-names: Zach
    affiliation: "University of Wisconsin-Madison, Forest and Wildlife Ecology"
    email: zmbre@outlook.com
    orcid: "https://orcid.org/0009-0002-7252-2716"
  - family-names: Majerus
    given-names: Annabelle
    affiliation: "University of Wisconsin-Madison, Forest and Wildlife Ecology"
    email: aemajerus@crimson.ua.edu
    orcid: "https://orcid.org/0009-0006-6432-0232"
  - family-names: Townsend
    given-names: Philip A.
    affiliation: "University of Wisconsin-Madison, Forest and Wildlife Ecology"
    email: ptownsend@wisc.edu
    orcid: "https://orcid.org/0000-0001-7003-8774"
# Related-identifier slots, filled in as DOIs are minted (nothing is entered
# as a placeholder value):
#   - EcoSIS reduced copy (spectra + metadata only, for discoverability): not
#     cited here; the Zenodo record is the primary dataset.
#   - This repository's own Zenodo DOI (v1.2) is the top-level `doi:`.
#   - Manuscript: add as `preferred-citation` once published.
references:
  # Data record on Zenodo (spectra, chemistry, instrument files and supporting
  # files). Published 2026-11-03 (version 1.0); title as on the record.
  - type: dataset
    title: "Supporting data for the effects of drying and milling treatments on estimates of foliar functional traits with VSWIR spectroscopy: leaf scans, processed spectra and replicate-pair differences"
    doi: "10.5281/zenodo.23504460"
    authors:
